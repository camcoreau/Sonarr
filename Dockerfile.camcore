FROM lscr.io/linuxserver/sonarr:latest

LABEL org.opencontainers.image.title="CamCore Sonarr"
LABEL org.opencontainers.image.description="Sonarr with CamCore branding"

COPY frontend/src/Content/Images/logo-full.png /app/sonarr/bin/UI/Content/Images/logo-full.png
COPY frontend/src/Content/Images/camcore-logo.svg /app/sonarr/bin/UI/Content/Images/logo.svg
COPY frontend/src/login.html /app/sonarr/bin/UI/login.html
COPY frontend/src/Content/Images/Icons/camcore-icon.svg /app/sonarr/bin/UI/Content/Images/Icons/camcore-icon.svg
COPY frontend/src/Content/Images/Icons/camcore-icon.svg /app/sonarr/bin/UI/Content/Images/Icons/safari-pinned-tab.svg
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/sonarr/bin/UI/Content/Images/Icons/camcore-apple-touch-icon.png
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/sonarr/bin/UI/Content/Images/Icons/apple-touch-icon.png
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/sonarr/bin/UI/Content/Images/Icons/favicon-32x32.png
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/sonarr/bin/UI/Content/Images/Icons/favicon-16x16.png
COPY frontend/src/Content/camcore-manifest.json /app/sonarr/bin/UI/Content/manifest.json
COPY frontend/src/Content/camcore-header.css /app/sonarr/bin/UI/Content/camcore-header.css

RUN sed -i 's#</head>#<link rel="stylesheet" href="/Content/camcore-header.css" /></head>#' /app/sonarr/bin/UI/index.html \
 && grep -q 'camcore-header.css' /app/sonarr/bin/UI/index.html
